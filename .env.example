# Copy to .env and fill in. Platforms left empty are reported as failed
# ("Missing configuration: ...") while the others still post.

# false = real posting (default). true = simulate posts; responses are flagged "dry_run": true.
DRY_RUN=false
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# --- LinkedIn: token with w_member_social (person) or w_organization_social (organization)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:REPLACE_ME
# YYYYMM; must be an active version (LinkedIn retires versions after ~1 year)
LINKEDIN_API_VERSION=202610

# --- X / Twitter: OAuth 1.0a user context (recommended; app needs Read and Write permission)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Alternative: OAuth 2.0 user-context token with tweet.write (expires ~2h). App-only bearer tokens cannot post.
TWITTER_OAUTH2_USER_TOKEN=

# --- Meta Graph API version (Facebook + Instagram)
FACEBOOK_GRAPH_VERSION=v24.0

# --- Facebook Page: Page access token with pages_manage_posts + pages_read_engagement
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Instagram: professional account linked to a Facebook Page; instagram_content_publish
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Publicly reachable JPEG used as the post image (Instagram posts require media)
INSTAGRAM_IMAGE_URL=

# --- Reddit: "script" app from https://www.reddit.com/prefs/apps (account without 2FA)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=python:automated-posting:1.0 (by /u/REPLACE_ME)
